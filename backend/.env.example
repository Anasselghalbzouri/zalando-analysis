# Laravel settings for LOCAL DEVELOPMENT ONLY. Copy to backend/.env (never commit .env).
# The app container creates backend/.env from this file on first start and generates APP_KEY.
# DB_HOST, DB_DATABASE, DB_USERNAME and DB_PASSWORD are injected by compose.yaml from the
# root .env, and container variables take precedence over this file.

# Neutral placeholder: the product name is undecided (Q-75).
APP_NAME="Storefront (dev)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Single origin through Nginx (ADR-003). Change if NGINX_PORT differs.
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 in the "mysql" service. Credentials come from compose (see the root .env).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Database drivers are the baseline; Redis is optional (ADR-007, Q-72).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional Redis (compose profile "redis"). To use it, set CACHE_STORE / QUEUE_CONNECTION /
# SESSION_DRIVER to redis after starting the profile.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is written to the log by default. With the "mail" profile, use:
# MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025 (UI on http://localhost:8025).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
