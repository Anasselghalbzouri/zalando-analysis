# Single-origin entry point (ADR-003, docker-architecture §1–§3).
# Rendered by the official nginx image at start-up: only ${NGINX_SPA_MODE} is substituted.
#   /api, /sanctum, /up  -> Laravel (PHP-FPM in the "app" service)
#   everything else      -> the React SPA (Vite dev server, or the built files in static mode)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    server_tokens off;
    autoindex off;
    client_max_body_size 20m;

    # Docker's embedded DNS: upstreams are resolved per request, so recreated containers are found again.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # ---- Laravel ----------------------------------------------------------
    location ~ ^/(api|sanctum)(/|$) {
        root /var/www/html/public;
        try_files $uri /index.php$is_args$args;
    }

    location = /up {
        root /var/www/html/public;
        try_files $uri /index.php$is_args$args;
    }

    # The only PHP entry point; reachable only through the try_files fallbacks above.
    location = /index.php {
        internal;
        root /var/www/html/public;
        set $php_upstream app:9000;
        fastcgi_pass $php_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # No other PHP file is ever executed or served.
    location ~ \.php$ {
        return 404;
    }

    # Hidden files (.env, .git, ...) are never served. Exceptions: /.well-known/ and Vite's
    # pre-bundled dependency cache (/node_modules/.vite/), which the dev server must serve.
    location ~ /\.(?!well-known/|vite/) {
        deny all;
    }

    # ---- React SPA --------------------------------------------------------
    include /etc/nginx/snippets/spa-${NGINX_SPA_MODE}.conf;
}
