# Docker Compose settings for LOCAL DEVELOPMENT ONLY.
# Copy to .env (never commit .env) and replace every "change-me" value with your own local value.
# These are not production credentials and must never be reused anywhere else.

# Host user and group IDs, so files written by the containers stay editable.
# Docker Desktop on Windows: keep 1000. Linux or WSL: use the output of `id -u` and `id -g`.
UID=1000
GID=1000

# Published ports (bound to 127.0.0.1 only).
NGINX_PORT=8080
MYSQL_FORWARD_PORT=3306
MAILPIT_UI_PORT=8025

# MySQL 8: application database and user. Compose passes them to Laravel as DB_*.
MYSQL_DATABASE=storefront
MYSQL_USER=storefront
MYSQL_PASSWORD=change-me-local-app-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# SPA serving mode: "vite" (dev server with HMR) or "static" (built files from frontend/dist).
NGINX_SPA_MODE=vite

# File watching by polling; needed when the repository is on a Windows drive.
VITE_USE_POLLING=true
